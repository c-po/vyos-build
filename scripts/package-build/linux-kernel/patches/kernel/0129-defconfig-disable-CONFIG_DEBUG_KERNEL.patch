From deb0856754207d22dd3b765552a883fdc1de6263 Mon Sep 17 00:00:00 2001
From: Frank Wunderlich <frank-w@public-files.de>
Date: Sat, 18 Apr 2026 17:00:31 +0200
Subject: [PATCH 129/134] defconfig: disable CONFIG_DEBUG_KERNEL

---
 arch/arm64/configs/mt7622_bpi-r64_defconfig | 2 +-
 arch/arm64/configs/mt7986a_bpi-r3_defconfig | 2 +-
 arch/arm64/configs/mt7988a_bpi-r4_defconfig | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/configs/mt7622_bpi-r64_defconfig b/arch/arm64/configs/mt7622_bpi-r64_defconfig
index ca1c75a30067..5383d6c77c01 100644
--- a/arch/arm64/configs/mt7622_bpi-r64_defconfig
+++ b/arch/arm64/configs/mt7622_bpi-r64_defconfig
@@ -306,7 +306,7 @@ CONFIG_DEBUG_FS=y
 CONFIG_DEBUG_SECTION_MISMATCH=y
 # CONFIG_SECTION_MISMATCH_WARN_ONLY is not set
 CONFIG_MAGIC_SYSRQ=y
-CONFIG_DEBUG_KERNEL=y
+#CONFIG_DEBUG_KERNEL=y
 # CONFIG_FTRACE is not set
 CONFIG_CRYPTO_ECHAINIV=y
 CONFIG_CRYPTO_CRC32=y
diff --git a/arch/arm64/configs/mt7986a_bpi-r3_defconfig b/arch/arm64/configs/mt7986a_bpi-r3_defconfig
index f5a5977c31e1..a06098557d0b 100644
--- a/arch/arm64/configs/mt7986a_bpi-r3_defconfig
+++ b/arch/arm64/configs/mt7986a_bpi-r3_defconfig
@@ -106,7 +106,7 @@ CONFIG_CRYPTO_SKCIPHER2=y
 CONFIG_DEBUG_FS=y
 CONFIG_DEBUG_FS_ALLOW_ALL=y
 CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
-CONFIG_DEBUG_KERNEL=y
+#CONFIG_DEBUG_KERNEL=y
 CONFIG_DEFAULT_CUBIC=y
 CONFIG_DEFAULT_DEADLINE=y
 CONFIG_DEFAULT_FQ_CODEL=y
diff --git a/arch/arm64/configs/mt7988a_bpi-r4_defconfig b/arch/arm64/configs/mt7988a_bpi-r4_defconfig
index 4ed120554d10..9f62fdfac408 100644
--- a/arch/arm64/configs/mt7988a_bpi-r4_defconfig
+++ b/arch/arm64/configs/mt7988a_bpi-r4_defconfig
@@ -106,7 +106,7 @@ CONFIG_CRYPTO_SKCIPHER2=y
 CONFIG_DEBUG_FS=y
 CONFIG_DEBUG_FS_ALLOW_ALL=y
 CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
-CONFIG_DEBUG_KERNEL=y
+#CONFIG_DEBUG_KERNEL=y
 CONFIG_DEFAULT_CUBIC=y
 CONFIG_DEFAULT_DEADLINE=y
 CONFIG_DEFAULT_FQ_CODEL=y
