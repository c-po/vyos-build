From 11c9760499283848b040ac18dfbe4abb3fa29695 Mon Sep 17 00:00:00 2001
From: Frank Wunderlich <frank-w@public-files.de>
Date: Fri, 9 Jan 2026 17:38:24 +0100
Subject: [PATCH 124/134] defconfig: r4: add options for k8s + docker

https://github.com/frank-w/BPI-Router-Linux/issues/154
---
 arch/arm64/configs/mt7988a_bpi-r4_defconfig | 22 +++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/arch/arm64/configs/mt7988a_bpi-r4_defconfig b/arch/arm64/configs/mt7988a_bpi-r4_defconfig
index 7515497bf904..4ed120554d10 100644
--- a/arch/arm64/configs/mt7988a_bpi-r4_defconfig
+++ b/arch/arm64/configs/mt7988a_bpi-r4_defconfig
@@ -1206,6 +1206,21 @@ CONFIG_NET_ACT_SKBMOD=m
 CONFIG_NET_ACT_TUNNEL_KEY=m
 CONFIG_NET_ACT_CT=m
 # CONFIG_NET_ACT_GATE is not set
+CONFIG_NETFILTER_ADVANCED=y
+CONFIG_NETFILTER_XTABLES_LEGACY=y
+CONFIG_IP_NF_IPTABLES_LEGACY=m
+CONFIG_IP_NF_TARGET_REDIRECT=m
+CONFIG_NETFILTER_XT_MATCH_COMMENT=y
+CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
+CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
+CONFIG_IP_NF_RAW=m
+CONFIG_NET_CLS_CGROUP=m
+CONFIG_IP_VS_RR=m
+CONFIG_VXLAN=m
+CONFIG_XFRM_USER=m
+CONFIG_INET_ESP=m
+CONFIG_NF_NAT_TFTP=m
+CONFIG_NF_CONNTRACK_TFTP=m
 
 #NFS Client
 CONFIG_NFS_FS=y
@@ -1272,6 +1287,13 @@ CONFIG_POSIX_MQUEUE_SYSCTL=y
 CONFIG_HAVE_ARCH_SECCOMP_FILTER=y
 CONFIG_SECCOMP_FILTER=y
 CONFIG_SECCOMP=y
+CONFIG_HUGETLBFS=y
+CONFIG_HUGETLB_PAGE=y
+CONFIG_CGROUP_HUGETLB=y
+CONFIG_BLK_DEV_THROTTLING=y
+CONFIG_IP_VS_NFCT=y
+CONFIG_IP_VS_PROTO_TCP=y
+CONFIG_IP_VS_PROTO_UDP=y
 
 CONFIG_I2C_MUX=y
 CONFIG_I2C_MUX_PCA954x=y
