#
# BananaPi BPI-R4 / BPI-R4 Pro (MediaTek MT7988A)
#
# SoC and board peripherals not enabled by vyos_defconfig. Requires the
# patch series in patches/kernel/arm64 (fwnode PCS, USXGMII PCS, MxL862xx).
# The Ethernet path is built in: as modules it probed after unused clocks
# were gated and hung the CPU (booting with clk_ignore_unused worked). PHYs
# that load firmware stay modular so build-linux-firmware.sh packages it.
#

#
# SoC platform
#
CONFIG_ARCH_MEDIATEK=y
CONFIG_COMMON_CLK_MT7988=y
CONFIG_PINCTRL_MT7988=y
CONFIG_MTK_INFRACFG=y
CONFIG_NVMEM_MTK_EFUSE=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_REGULATOR_RT5190A=y

#
# CPU frequency and thermal
#
CONFIG_ARM_MEDIATEK_CPUFREQ=y
CONFIG_ARM_MEDIATEK_CCI_DEVFREQ=y
CONFIG_DEVFREQ_GOV_PASSIVE=y
CONFIG_MTK_THERMAL=y
CONFIG_MTK_LVTS_THERMAL=y
CONFIG_CPU_THERMAL=y
CONFIG_PWM=y
CONFIG_PWM_MEDIATEK=y
CONFIG_SENSORS_PWM_FAN=m
CONFIG_SENSORS_INA2XX=m

#
# Storage: eMMC/SD, SPI-NAND
#
CONFIG_MMC_MTK=m
CONFIG_SPI=y
CONFIG_SPI_MT65XX=y
CONFIG_MTD=y
CONFIG_MTD_SPI_NAND=y
CONFIG_MTD_NAND_ECC_MEDIATEK=y
CONFIG_MTD_UBI=y
CONFIG_MTD_UBI_BLOCK=y

#
# PCIe and USB
#
CONFIG_PCIE_MEDIATEK_GEN3=y
CONFIG_PHY_MTK_TPHY=y
CONFIG_PHY_MTK_XSPHY=y
CONFIG_USB_XHCI_MTK=m

#
# I2C bus, mux, RTC
#
CONFIG_I2C_MT65XX=y
CONFIG_I2C_MUX_PCA954x=m
# selected by I2C_MUX_PCA954x
CONFIG_RESET_GPIO=m
CONFIG_RTC_DRV_PCF8563=m

#
# Ethernet: frame engine, PCS, SerDes
#
CONFIG_NET_VENDOR_MEDIATEK=y
CONFIG_NET_MEDIATEK_SOC=y
CONFIG_NET_MEDIATEK_SOC_WED=y
CONFIG_PHYLINK=y
CONFIG_PCS_MTK_LYNXI=y
CONFIG_PCS_MTK_USXGMII=y
CONFIG_PHY_MTK_XFI_TPHY=y
CONFIG_SFP=y

#
# Switches: MT7988 built-in switch, MxL86252 on the R4 Pro
#
# NET_DSA=y needs BRIDGE=y, overrides 51-bridge.config for arm64
CONFIG_BRIDGE=y
CONFIG_NET_DSA=y
CONFIG_NET_DSA_MT7530=y
CONFIG_NET_DSA_MT7530_MMIO=y
CONFIG_NET_DSA_TAG_MTK=y
CONFIG_NET_DSA_MXL862=m
CONFIG_NET_DSA_TAG_MXL862=m
CONFIG_NET_DSA_TAG_MXL862_8021Q=m
# selected by NET_DSA_MT7530
CONFIG_MEDIATEK_GE_PHY=y

#
# PHYs: internal 1G/2.5G, AS21xxx 10G (R4 Pro), MxL switch PHYs
# The built-in switch attaches its PHYs at probe, before modules can load.
#
CONFIG_MEDIATEK_GE_SOC_PHY=y
# selected by MEDIATEK_GE_SOC_PHY
CONFIG_PHY_PACKAGE=y
CONFIG_MEDIATEK_2P5GE_PHY=m
CONFIG_AS21XXX_PHY=m
CONFIG_MAXLINEAR_GPHY=m

#
# Wi-Fi 7 card (BPI-R4-NIC-BE14)
#
CONFIG_MT7996E=m
