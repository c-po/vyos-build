#
# MediaTek MT7988A (Filogic 880) -- BananaPi BPI-R4 and friends
#
# Enabling ARCH_MEDIATEK also builds the in-tree device trees:
#   mediatek/mt7988a-bananapi-bpi-r4.dtb
#   mediatek/mt7988a-bananapi-bpi-r4-2g5.dtb
#   mediatek/mt7988a-bananapi-bpi-r4-{sd,emmc}.dtbo   <- mmc0 is disabled in the
#                                                        base DTB; one of these
#                                                        overlays must be applied
#
# Anything on the SD/eMMC boot path must be built in (=y): clocks, pinctrl,
# console and MMC all have to be live before the initramfs is unpacked.
# Everything else is a module.
#
CONFIG_ARCH_MEDIATEK=y
CONFIG_MTK_INFRACFG=y
CONFIG_ARM_MEDIATEK_CPUFREQ=y

# Clocks and pinctrl are "default ARCH_MEDIATEK" and come in automatically,
# but pin them explicitly so a defaults change cannot silently unboot the board.
CONFIG_COMMON_CLK_MEDIATEK=y
CONFIG_COMMON_CLK_MT7988=y
CONFIG_PINCTRL_MT7988=y

# Serial console: DT is "mediatek,mt7988-uart","mediatek,mt6577-uart".
# NB the MT7988 UART is 8250-compatible (ttyS0), NOT PL011/ttyAMA0.
CONFIG_SERIAL_8250_MT6577=y

# SD / eMMC -- the rootfs lives here
CONFIG_MMC_MTK=y

# Also the reset-controller for the XFI PHYs and PLL (resets = <&watchdog 14..16>),
# so the 10G SerDes does not come up without it.
CONFIG_MEDIATEK_WATCHDOG=y

# MEDIATEK_GE_SOC_PHY hard-depends on this; it also holds LVTS calibration data.
CONFIG_NVMEM_MTK_EFUSE=y

# Buses. SPI and MTD are enabled here rather than in the arm64 defconfig
# because nothing else in the generic arm64 build needs them - the MT7988
# board's SPI-NAND (compatible "mediatek,mt7988-spi-quad","mediatek,spi-ipm")
# hangs off spi0 and is driven through the generic spi-mem / MTD SPI-NAND
# stack, so no dedicated SNFI driver is required.
CONFIG_I2C_MT65XX=y
CONFIG_SPI=y
CONFIG_SPI_MEM=y
CONFIG_SPI_MT65XX=y
CONFIG_MTD=y
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_SPI_NOR=y
CONFIG_MTD_SPI_NAND=y

# Ethernet: SoC MAC, built-in switch (4x RJ45), internal PHYs, 10G SFP+ SerDes
CONFIG_NET_VENDOR_MEDIATEK=y
CONFIG_NET_MEDIATEK_SOC=m
CONFIG_NET_DSA_MT7530=m
CONFIG_NET_DSA_MT7530_MMIO=m
CONFIG_NET_DSA_MT7530_MDIO=m
CONFIG_MEDIATEK_GE_PHY=m
CONFIG_MEDIATEK_GE_SOC_PHY=m
CONFIG_MEDIATEK_2P5GE_PHY=m
CONFIG_PHY_MTK_XFI_TPHY=m
CONFIG_SFP=m

# USB 3.0 and PCIe (M.2 NVMe / mPCIe)
CONFIG_USB_XHCI_MTK=m
CONFIG_PHY_MTK_TPHY=m
CONFIG_PHY_MTK_XSPHY=m
CONFIG_PCIE_MEDIATEK_GEN3=m

# Board peripherals: PMIC, RTC, SFP cage I2C mux, PWM fan, thermal
CONFIG_REGULATOR_RT5190A=m
CONFIG_RTC_DRV_PCF8563=m
CONFIG_I2C_MUX_PCA954x=m
CONFIG_SENSORS_PWM_FAN=m
CONFIG_PWM_MEDIATEK=m
CONFIG_MTK_THERMAL=m
CONFIG_MTK_LVTS_THERMAL=m
CONFIG_ARM_MEDIATEK_CCI_DEVFREQ=m
CONFIG_DEVFREQ_GOV_PASSIVE=m
